# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
.venv-desktop-tests/
venv/

# Local configuration and secrets
.env
.env.*
!.env.example
config/candidate_profile.yaml
config/companies.yaml
config/rag_sources.yaml
config/companies.local.yaml
config/rag_sources.local.yaml
# Group-bot webhook URLs contain secrets; only notify.example.yaml is tracked.
config/notify.yaml
config/notify.local.yaml
*.pem
*.key
*.p12
*.pfx

# Stateful and generated data
.desktop-runtime-tests/
artifacts/
.data/
# Local scrape output is not committed ...
data/*
# ... except the curated seed catalog, which is meant to ship with the repo so
# a fresh clone starts with real postings (see data/seed/README.md).
!data/seed/
!data/seed/**
outputs/
reports/
tmp/
work/
backups/
*.db
*.sqlite
*.sqlite3
*.dump
*.log
*.zip
test-results/
generatedlogs/

# Private local documentation captures (keep locally, never publish)
/docs/assets/applications.png
/docs/assets/schedule.png

# Browser and account state
playwright/.auth/
cookies*.json
storage-state*.json
user-data-dir/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# 企业性质标注是模板的一部分，需要随仓库分发
!config/company_nature.yaml
